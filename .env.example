# ==============================================================================
# Tapo D235 Doorbell Press MQTT Sniffer - Docker Environment Config
# Copy this file to .env and fill in your MQTT password:
#   cp .env.example .env
# ==============================================================================

# MQTT Broker Details
MQTT_BROKER=10.0.0.228
MQTT_PORT=1883
MQTT_TOPIC=doorbell/press
MQTT_USER=homeassistant
MQTT_PASS=YOUR_MQTT_PASSWORD_HERE

# Doorbell Settings
# Tapo D235 IP address. Leave blank or set to 'auto' to accept packets from any IP on UDP 20005
DOORBELL_IP=10.0.10.112
UDP_PORT=20005
PULSE_TIME=2.0

# Home Assistant Auto-Discovery
HA_DISCOVERY=true
HA_DISCOVERY_PREFIX=homeassistant
