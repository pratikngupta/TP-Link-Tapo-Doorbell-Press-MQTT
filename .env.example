# ==============================================================================
# Tapo D130 / D235 Doorbell Press MQTT Sniffer - Docker Environment Config
# Copy this file to .env and fill in your MQTT password:
#   cp .env.example .env
# ==============================================================================

# MQTT Broker Details
MQTT_BROKER=10.0.0.228
MQTT_PORT=1883
MQTT_TOPIC=doorbell/press
MQTT_USER=homeassistant
MQTT_PASS=YOUR_MQTT_PASSWORD_HERE

# Doorbell Settings
# Tapo Doorbell IP address.
# Set to 'auto' (recommended) to accept packets from any device/relay on UDP 20005.
# Or specify a single IP or comma-separated IPs: e.g. 10.0.10.112 or 10.0.10.112, 10.0.10.113
DOORBELL_IP=auto
UDP_PORT=20005
PULSE_TIME=2.0
# Cooldown period in seconds to ignore duplicate burst packets from a single press
COOLDOWN_TIME=5.0

# Home Assistant Auto-Discovery
HA_DISCOVERY=true
HA_DISCOVERY_PREFIX=homeassistant
