[Unit]
Description=Tapo D235 Doorbell Press MQTT Sniffer
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/mqttsniffer/mqttsniffer.env
ExecStart=/opt/mqtt_sniffer_env/bin/python /etc/mqttsniffer/mqttsniffer.py
Restart=always
RestartSec=5
User=root
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
